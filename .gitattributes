# Font files and their upstream license texts are byte-for-byte copies of what
# the copyright holders published. Git must not normalize their line endings or
# flag their whitespace, or the licenses would no longer match the originals.
src-tauri/fonts/** -text -whitespace
src-tauri/fonts/**/*.ttf binary

# Not itself a vendored file, but it quotes those license texts in full, so it
# is held to the same rule for the same reason.
THIRD_PARTY_NOTICES.md -text -whitespace

# The vendored Unicode emoji data is a byte-for-byte copy of what the Unicode
# Consortium published, and the generator re-derives the checked-in Rust tables
# from it. Normalizing its line endings would make a refresh on Windows churn
# every line and could change what the generator parses.
scripts/unicode-data/*.txt -text -whitespace
